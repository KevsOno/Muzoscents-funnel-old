# Storefront-only routing template for the dedicated e-commerce domain.
# Copy to _redirects when deploying the e-commerce Netlify site.

/kdstore              /kdstore.html              200
/kdstore.html         /kdstore.html              200
/store/*/manifest.json  https://kevsono-kevs-digital-bos.hf.space/store/:splat/manifest.json  200
/store/*                /kdstore.html              200
/store.js             /store.js                  200
/kdstore.js           /kdstore.js                200
/kdstore01.js         /kdstore01.js              200
/kdstore1.js          /kdstore1.js               200
/kdstore12.js         /kdstore12.js              200
/kdstore123.js        /kdstore123.js             200
/kdstore_recent.js    /kdstore_recent.js         200
/kd-config.js         /kd-config.js              200
/kd-buttons.css       /kd-buttons.css            200
/tailwind.css         /tailwind.css              200
/offline.html         /offline.html              200

/public               https://kevsono-kevs-digital-bos.hf.space/public         200
/public/*             https://kevsono-kevs-digital-bos.hf.space/public/:splat  200
/storefront/config    https://kevsono-kevs-digital-bos.hf.space/storefront/config   200
/storefront/upload    https://kevsono-kevs-digital-bos.hf.space/storefront/upload   200
/storefront/publish   https://kevsono-kevs-digital-bos.hf.space/storefront/publish  200
/storefront/unpublish https://kevsono-kevs-digital-bos.hf.space/storefront/unpublish 200

# Send backroom / staff routes to the backroom host
/dispatch             https://kevsbos.netlify.app/dispatch/        302
/dispatch/*           https://kevsbos.netlify.app/dispatch/:splat  302
/kdadmin              https://kevsbos.netlify.app/kdadmin          302
/kdpos                https://kevsbos.netlify.app/kdpos            302
/kdsiginin            https://kevsbos.netlify.app/kdsiginin        302
