      "url": "/fastfood/sandbox.html?page=order",
      "icons": [{ "src": "/fastfood/icons/order-icon.png", "sizes": "96x96" }]
    },
    {
      "name": "Call Us",
      "short_name": "Call",
      "description": "Call for delivery",
      "url": "/fastfood/sandbox.html?page=call",
      "icons": [{ "src": "/fastfood/icons/call-icon.png", "sizes": "96x96" }]
