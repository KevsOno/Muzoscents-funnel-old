{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-bos",
  "description": "Permissions for the main window when displaying the remote Kevs bOS origin.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://mzfunnels.netlify.app/*",
      "https://kevsono-kevs-digital-bos.hf.space/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:allow-open-url",
    "opener:allow-default-urls",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
