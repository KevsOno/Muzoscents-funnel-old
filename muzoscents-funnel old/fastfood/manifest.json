    },
    {
      "src": "/fastfood/screenshots/mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Order hot meals instantly"
    }
  ],
  "shortcuts": [
    {
      "name": "Order Now",
      "short_name": "Order",
